    "chokidar": "^4.0.3",
    "commander": "^11.1.0",
    "discord.js": "^14.7.1",
    "discord.js-rate-limiter": "^1.3.2",
    "dotenv": "^16.5.0",
    "glob": "^13.0.0",
    "libsodium-wrappers": "^0.7.15",
    "nodemon": "^3.1.10",
    "pg": "^8.16.0",
    "pg-connection-string": "^2.9.0",
