    "backup:create": "node scripts/backup-cli.js create",
    "backup:list": "node scripts/backup-cli.js list",
    "backup:cleanup": "node scripts/backup-cli.js cleanup",
    "backup:schedule": "node scripts/scheduled-backup.js"
