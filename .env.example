# ================================
# REQUIRED CONFIGURATION
# ================================

# Discord Bot Token (Required)
# Get from: https://discord.com/developers/applications
BOT_TOKEN=your_discord_bot_token_here

# PostgreSQL Database URL (Required)
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/raymond_db

# Bot Owner Discord User ID (Required)
# Right-click your profile in Discord (Developer Mode enabled) → Copy ID
OWNER_ID=your_discord_user_id_here

# OpenRouter API Key (Required for AI features)
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_api_key_here

# Bot Creator Name (Optional)
BOT_CREATOR_NAME=YourName

# ================================
# AI PERSONA CONFIGURATION
# ================================

# Active AI Persona (default: raymond)
# Options: raymond, default
AI_PERSONA=raymond

# ================================
# AI ACCESS CONTROL
# ================================

# Comma-separated Discord user IDs allowed to use AI
AI_ALLOWED_USERS=123456789012345678,987654321098765432

# Comma-separated Discord role IDs allowed to use AI
AI_ALLOWED_ROLES=

# Enable auto-chat on mentions/replies (default: true)
AI_AUTO_CHAT_ENABLED=true

# ================================
# AI RATE LIMITING
# ================================

# Messages per hour for regular users (default: 3)
AI_HOURLY_LIMIT_REGULAR=3

# Messages per hour for whitelisted users (default: 6)
AI_HOURLY_LIMIT_WHITELISTED=6

# Legacy daily limit (kept for backward compatibility)
AI_DAILY_LIMIT=5

# ================================
# AI MEMORY CONFIGURATION
# ================================

# Enable AI memory system (default: true)
AI_MEMORY_ENABLED=true

# Memory retrieval mode: semantic, keyword, or hybrid (default: hybrid)
AI_MEMORY_RETRIEVAL=hybrid

# Number of memories to retrieve (default: 3)
AI_MEMORY_TOP_K=3

# Memory cache TTL in milliseconds (default: 60000)
AI_MEMORY_CACHE_TTL_MS=60000

# Max characters for memory context (default: 1200)
AI_MEMORY_MAX_CHARS=1200

# Minimum query length for search (default: 5)
AI_MEMORY_MIN_QUERY_CHARS=5

# Minimum word length in queries (default: 3)
AI_MEMORY_MIN_WORD_CHARS=3

# ================================
# SEMANTIC SEARCH (RAG) CONFIGURATION
# ================================

# Enable vector embeddings for semantic search (default: true)
AI_EMBEDDINGS_ENABLED=true

# Embedding model (default: Xenova/all-MiniLM-L6-v2)
AI_EMBEDDINGS_MODEL=Xenova/all-MiniLM-L6-v2

# Batch size for embedding backfill (default: 10)
AI_EMBEDDINGS_BACKFILL_BATCH=10

# Similarity threshold for semantic search 0-1 (default: 0.7)
# Higher = more strict, Lower = more lenient
AI_MEMORY_SIMILARITY_THRESHOLD=0.7

# ================================
# AUTO-MEMORY LEARNING
# ================================

# Enable automatic fact extraction (default: true)
AI_AUTO_MEMORY_ENABLED=true

# Minimum message length to analyze (default: 15)
AI_AUTO_MEMORY_MIN_LENGTH=15

# Cooldown between extractions in milliseconds (default: 3000)
AI_AUTO_MEMORY_COOLDOWN_MS=3000

# ================================
# AI MODEL CONFIGURATION
# ================================

# OpenRouter model (default: openrouter/free)
OPENROUTER_MODEL=openrouter/free

# Model priority (comma-separated, free models)
OPENROUTER_MODEL_PRIORITY=google/gemma-2-9b-it:free,meta-llama/llama-3.1-8b-instruct:free

# Discover free models automatically (default: true)
OPENROUTER_DISCOVER_FREE_MODELS=true

# Request timeout in milliseconds (default: 10000)
OPENROUTER_TIMEOUT_MS=10000

# Max model attempts before failing (default: 8)
OPENROUTER_MAX_MODEL_ATTEMPTS=8

# ================================
# AI TOKEN LIMITS
# ================================

# Max context tokens (default: 1000)
AI_MAX_CONTEXT_TOKENS=1000

# Max output tokens (default: 200)
AI_MAX_OUTPUT_TOKENS=200

# ================================
# SITE INFORMATION (for OpenRouter)
# ================================

# Your site URL
SITE_URL=https://github.com/ahmedtouzani/Raymond

# Your site name
SITE_NAME=Raymond Bot

# ================================
# OPTIONAL: DEVELOPMENT
# ================================

# Guild ID for slash command testing (optional)
GUILD_ID=your_test_server_id_here

# ================================
# NOTES
# ================================

# 1. Never commit .env to version control
# 2. Keep your tokens and API keys secret
# 3. Use .env.example as a template
# 4. PostgreSQL must have pgvector extension installed
# 5. Run migrations after setup: npm run migrate
# 6. Backfill embeddings: npm run ai:embeddings:backfill
