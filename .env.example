# Required: configure secrets privately; never commit a .env file.
BOT_TOKEN=your_discord_bot_token
DATABASE_URL=postgresql://username:password@host:5432/database
OWNER_ID=your_discord_user_id

# Default prefix for new servers.
GLOBAL_PREFIX=!
PREFIX=!

# Optional slash-command development guild.
GUILD_ID=

# Isolate development activity to a separate test server.
DEVELOPMENT_MODE=true
DEVELOPMENT_GUILD_IDS=your_test_guild_id
DEVELOPMENT_AUTOMATION_ENABLED=false

# Use verified TLS when required by your database host.
# DATABASE_SSL=true
# DATABASE_SSL_CA_FILE=/path/to/ca.pem

# Apply schema migrations before starting: npm run migrate
